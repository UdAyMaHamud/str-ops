PORT=8000
NODE_ENV=development
APP_ENV=staging
CLIENT_URL=http://localhost:5173
# MongoDB Atlas connection string. Empty = local database in backend/.data (development only)
DB_STRING=
JWT_SECRET=change_me_staging_secret
# Google sign-in: OAuth 2.0 Web client ID from Google Cloud Console (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Email (Gmail app password, not the account password). Empty = codes are printed in this console.
SMTP_USER=
SMTP_PASS=
# Extra browser origins allowed by CORS, comma separated (needed in production)
CLIENT_ORIGINS=
# Number of proxies in front of the app (1 behind nginx), so rate limiting sees the real IP
TRUST_PROXY=
# Set to false once real data flows in, so mock data is never loaded
SEED_MOCK=true
# Hostaway API (Settings > Hostaway API in your Hostaway dashboard)
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=
# Minutes between full syncs (webhooks keep it current in between)
HOSTAWAY_SYNC_MINUTES=15
# Basic-auth login you also enter on the Hostaway webhook, so only Hostaway can post to it
HOSTAWAY_WEBHOOK_USER=
HOSTAWAY_WEBHOOK_PASS=
